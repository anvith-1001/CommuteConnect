{
  "name": "commuteconnect-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/config.mjs --same-origin && ng serve --host 0.0.0.0 --proxy-config proxy.conf.cjs",
    "build": "node scripts/config.mjs && ng build",
    "check": "ng build --configuration development",
    "test:e2e": "node scripts/config.mjs --same-origin && node ../CommuteConnect-backend/test/run-browser.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@types/google.maps": "^3.66.2",
    "@types/leaflet": "^1.9.22",
    "flatpickr": "^4.6.13",
    "leaflet": "^1.9.4",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "typescript": "~5.9.3"
  }
}